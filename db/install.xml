<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/blerify/db" VERSION="20260824" COMMENT="XMLDB file for Moodle mod/blerify"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="blerify" COMMENT="Blerify activity instances">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Certificate name chosen by the teacher"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="projectid" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Blerify project selected for this activity"/>
        <FIELD NAME="templateid" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Blerify template selected for this activity"/>
        <FIELD NAME="templatename" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Cached template title for display"/>
        <FIELD NAME="completionissue" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Issue automatically when the grade threshold is met"/>
        <FIELD NAME="passgrade" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="70" SEQUENCE="false" COMMENT="Minimum course grade percentage required to issue"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course_idx" UNIQUE="false" FIELDS="course"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="blerify_credentials" COMMENT="Blerify issued credentials">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="blerifyid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="credentialid" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Blerify credential _id"/>
        <FIELD NAME="organizationid" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Organization the credential was created under"/>
        <FIELD NAME="projectid" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Project the credential was created under"/>
        <FIELD NAME="templateid" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Template the credential was created with"/>
        <FIELD NAME="status" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="pending" SEQUENCE="false" COMMENT="pending, issuing, issued, claimed or error"/>
        <FIELD NAME="remotestatus" TYPE="char" LENGTH="32" NOTNULL="false" SEQUENCE="false" COMMENT="Last status reported by the API: PENDING, SENT or DELIVERED"/>
        <FIELD NAME="code" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Claim code used to build the wallet deeplink"/>
        <FIELD NAME="errordetail" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="reissues" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="How many times Moodle re-issued this credential to recover a missing certificate"/>
        <FIELD NAME="timechecked" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Last time the claim state was read back from Blerify"/>
        <FIELD NAME="timeissued" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timeclaimed" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="blerifyid_fk" TYPE="foreign" FIELDS="blerifyid" REFTABLE="blerify" REFFIELDS="id"/>
        <KEY NAME="userid_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="blerifyid_userid_idx" UNIQUE="true" FIELDS="blerifyid, userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
